# Copy this file to `.env` (which is gitignored) and fill in real values.
# Only Reddit ingestion (src/data_pipeline/reddit.py) needs credentials --
# Wikipedia, Google Trends, and price (yfinance/ccxt) need none.

# --- Reddit API credentials (free) ---
# 1. Log in to Reddit, go to https://www.reddit.com/prefs/apps
# 2. Click "create app" / "create another app" at the bottom.
# 3. Choose type "script".
# 4. "redirect uri" can be anything valid, e.g. http://localhost:8080 --
#    it's not used for script-type read-only access.
# 5. After creating it:
#      REDDIT_CLIENT_ID     = the string under the app name (looks random,
#                              ~14 chars, just under "personal use script")
#      REDDIT_CLIENT_SECRET = the "secret" field shown on the app page
#      REDDIT_USER_AGENT    = any descriptive string identifying your app,
#                              e.g. "narrative-arbitrage/0.1 by u/<your_username>"
#                              (Reddit will rate-limit/block generic or
#                              missing user agents)
#
# This is free -- no payment or approval wait, script apps are issued
# instantly to any Reddit account.

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=narrative-arbitrage/0.1 by u/your_username_here
